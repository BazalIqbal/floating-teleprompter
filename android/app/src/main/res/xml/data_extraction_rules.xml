<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied by cloud backup or device-to-device transfer: scripts stay on this
     phone (use Settings › Export for backups) and the encrypted API key is device-bound. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
